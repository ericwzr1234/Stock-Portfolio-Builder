# ── Node / Capacitor (generated; Mac-only build artifacts) ──
node_modules/

# ── iOS build artifacts (the ios/ project is generated by `npx cap add ios`) ──
ios/App/Pods/
ios/App/build/
ios/DerivedData/
ios/build/
*.xcuserstate

# ── Python ──
__pycache__/
*.pyc

# ── OS ──
.DS_Store
Thumbs.db

# ── Personal data — NEVER commit ──
# Each machine/user keeps its own portfolio; cross-machine sync of holdings is via the
# app's LAN-sync feature, not git. (Keeping it out of the repo also matters for sharing.)
portfolio.json
portfolio.dev.json
portfolio.*.json

# ── Claude Code harness config — machine-specific ──
# The preview runtime differs by OS (Windows `py -3` vs Mac `python3`), so each machine
# keeps its own .claude/launch.json. See docs/DEV_WORKFLOW.md to recreate it.
.claude/

# ── Generated cache (E1.3 ticker search) — refreshed daily from the public symbol directory ──
ticker_directory.json

# ── misc local ──
*.local
